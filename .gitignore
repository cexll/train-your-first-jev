.venv/
.venv-acceptance/

# The vendored upstream source is part of this repository. These negations also
# override a personal `vendor/` entry in core.excludesFile, which would otherwise
# hide it from `git status` and from a careless `git add -A`.
!vendor/
!vendor/**

# Python leftovers, including the ones `uv sync` writes into vendor/. These come
# after the negations above so that they still apply inside vendor/.
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.DS_Store

# Generated by the course commands; regenerate instead of committing.
runs/
evidence/
evidence-final/
data/
*.pt
